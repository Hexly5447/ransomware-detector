# Virtual environment
.venv/

# VS Code / IDE
.vs/
.vscode/

# Python cache
__pycache__/
*.py[cod]
*.egg-info/

# Runtime artifacts (structure kept via .gitkeep)
logs/*
!logs/.gitkeep
quarantine/*
!quarantine/.gitkeep
test_folder/*
!test_folder/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# OS junk
Thumbs.db
.DS_Store
